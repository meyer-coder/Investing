 "genomes": [
  {
   "name": "Trend or Washout",
   "thesis": "Long in a rising trend and after a washout; out when both fail.",
   "rationale": "generation 0, written by Claude for this island",
   "entry_rules": [
    {
     "when": "close > sma20 and sma20_slope > 0",
