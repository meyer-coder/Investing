 "genomes": [
  {
   "name": "Calm Trend + Z-Dip Core",
   "thesis": "Long while NQ is above its 50-day mean in a calm market, also after a two-sigma dip above the 200-day or a reclaim of the 50-day; out on a volatility blow-out or a break of the 50-day that is not oversold.",
   "rationale": "round 3, Claude: the trend-plus-dip leader with its clutter removed",
   "entry_rules": [
    {
     "when": "close > sma50 and vol20 < 0.25",
     "weight": 1.0
    },
    {
     "when": "zscore20 < -1.35 and close > sma200",
     "weight": 1.0
    },
    {
     "when": "cross_above(close, sma50)",
     "weight": 1.0
    }
   ],
   "exit_rules": [
    {
     "when": "vol20 > 0.45"
    },
    {
     "when": "close < sma50 and zscore20 > -1.0"
    }
   ],
   "risk": {
    "max_position_pct": 1.0,
