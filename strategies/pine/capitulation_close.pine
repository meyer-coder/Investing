//@version=6
// Capitulation Close — from evotrader strategies/quick_leveraged.json.
//
// Daily bars only. The signal is read on the close and the order fills at the
// NEXT bar's open (process_orders_on_close=false), exactly as the Python
// backtest does. Stops and targets are checked on the close, not intrabar,
// again to match the backtest; switch to intrabar stops only if you re-test.
//
// Tested on leveraged funds (TQQQ, SOXL, MUU, RIOX) with "Threshold scale" = 1.
// On an NQ1!, MNQ1!, NDX or QQQ chart set the scale to 0.333, so a 4% move in a
// 3x fund becomes the equivalent 1.33% move in the index.
strategy("Capitulation Close (evotrader)", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=25, commission_type=strategy.commission.percent,
     commission_value=0.01, slippage=1, process_orders_on_close=false)

scale     = input.float(1.0, "Threshold scale (1 = 3x fund chart, 0.333 = NQ/QQQ chart)", step=0.001)
dropPct   = input.float(4.0, "Down day, %") / 100 * scale
lowFrac   = input.float(0.25, "Close within this bottom fraction of the day's range")
volMult   = input.float(1.3, "Volume vs its 20-day average")
takePct   = input.float(3.0, "Exit after a close this far above entry, %") / 100 * scale
targetPct = input.float(4.0, "Hard target, % (checked on the close)") / 100 * scale
stopPct   = input.float(8.0, "Hard stop, % (checked on the close)") / 100 * scale
maxBars   = input.int(2, "Exit after this many bars held")
cooldown  = input.int(1, "Bars to wait after an exit before re-entering")

ret1   = close / close[1] - 1
volAvg = ta.sma(volume, 20)
volRat = volAvg > 0 ? volume / volAvg : 1.0
rangeQ = (close - low) / (high - low + 0.0001)

setup = ret1 < -dropPct and rangeQ < lowFrac and volRat > volMult

// remember the bar an exit filled on, for the cooldown
var int lastExitBar = -100000
var int closedSeen = 0
if strategy.closedtrades > closedSeen
    closedSeen := strategy.closedtrades
    lastExitBar := bar_index

flat     = strategy.position_size == 0
canEnter = flat and (bar_index - lastExitBar) >= cooldown

if canEnter and setup
    strategy.entry("L", strategy.long)

if not flat
    barsHeld = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    posRet   = close / strategy.position_avg_price - 1
    if posRet <= -stopPct or posRet >= targetPct or posRet > takePct or barsHeld >= maxBars
        strategy.close("L")

plotshape(setup and canEnter, title="Capitulation setup", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.teal, 0), size=size.small,
     text="buy next open")
alertcondition(setup and canEnter, "Capitulation Close: buy at next open",
     "Capitulation Close setup on {{ticker}}: buy at the next open")
