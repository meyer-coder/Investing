//@version=6
// Combo: All Five Setups — from evotrader strategies/quick_leveraged.json.
//
// Any of five mean-reversion setups on the close buys at the next open:
//   1. capitulation: down 4%, close in the bottom quarter of the range, volume 1.3x
//   2. oversold: RSI(7) under 40 with the close above the 50-day mean
//   3. red day above the 50: down 4.5%, close above the 50-day, volume at least average
//   4. prior-low break: close below yesterday's low, above the 50-day, volume 1.2x
//   5. pullback cluster: two red closes, five-day return under -3%, above the 50-day, volume 1.1x
// Exit at the open after the first close 3% above entry or after two bars;
// 8% stop and 4% target checked on the close; one bar of cooldown.
//
// The Python backtest runs this as a book of up to five 20% slots across
// several funds. A Pine strategy holds one symbol, so on a chart it is one
// position at a time: same entries and exits, different portfolio arithmetic.
// On an NQ/QQQ chart set "Threshold scale" to 0.333.
strategy("Combo: All Five Setups (evotrader)", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=20, commission_type=strategy.commission.percent,
     commission_value=0.01, slippage=1, process_orders_on_close=false)

scale     = input.float(1.0, "Threshold scale (1 = leveraged fund chart, 0.333 = NQ/QQQ chart)", step=0.001)
takePct   = input.float(3.0, "Exit after a close this far above entry, %") / 100 * scale
targetPct = input.float(4.0, "Hard target, % (checked on the close)") / 100 * scale
stopPct   = input.float(8.0, "Hard stop, % (checked on the close)") / 100 * scale
maxBars   = input.int(2, "Exit after this many bars held")
cooldown  = input.int(1, "Bars to wait after an exit before re-entering")
useCap    = input.bool(true, "Use setup 1: capitulation close")
useRsi    = input.bool(true, "Use setup 2: oversold dip above the 50")
useRed    = input.bool(true, "Use setup 3: red day above the 50")
usePlow   = input.bool(true, "Use setup 4: prior-low break on volume")
usePull   = input.bool(true, "Use setup 5: pullback cluster")

ret1   = close / close[1] - 1
ret5   = close / close[5] - 1
sma50  = ta.sma(close, 50)
rsi7   = ta.rsi(close, 7)
volAvg = ta.sma(volume, 20)
volRat = volAvg > 0 ? volume / volAvg : 1.0
rangeQ = (close - low) / (high - low + 0.0001)

capit = useCap  and ret1 < -0.04 * scale and rangeQ < 0.25 and volRat > 1.3
overs = useRsi  and rsi7 < 40 and close > sma50
redd  = useRed  and ret1 < -0.045 * scale and close > sma50 and volRat > 1.0
plow  = usePlow and close < low[1] and close > sma50 and volRat > 1.2
pull  = usePull and ret1 < 0 and ret1[1] < 0 and ret5 < -0.03 * scale and close > sma50 and volRat > 1.1
setup = capit or overs or redd or plow or pull

var int lastExitBar = -100000
var int closedSeen = 0
if strategy.closedtrades > closedSeen
    closedSeen := strategy.closedtrades
    lastExitBar := bar_index

flat     = strategy.position_size == 0
canEnter = flat and (bar_index - lastExitBar) >= cooldown

if canEnter and setup
    strategy.entry("L", strategy.long)

if not flat
    barsHeld = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    posRet   = close / strategy.position_avg_price - 1
    if posRet <= -stopPct or posRet >= targetPct or posRet > takePct or barsHeld >= maxBars
        strategy.close("L")

which = capit ? "cap" : overs ? "rsi" : redd ? "red" : plow ? "plow" : pull ? "pull" : ""
plotshape(setup and canEnter, title="Setup", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.teal, 0), size=size.small)
alertcondition(setup and canEnter, "Combo All Five: buy at next open",
     "Combo setup on {{ticker}}: buy at the next open")
