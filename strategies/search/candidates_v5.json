 "genomes": [
  {
   "name": "I3 Prior Low, 1.5x Volume",
   "thesis": "Close under yesterday's low above the 50-day on 1.5x volume.",
   "entry_rules": [
    {
     "when": "close < prev(low) and close > sma50 and volume_ratio > 1.5",
     "weight": 0.25
    }
   ],
   "exit_rules": [
    {
     "when": "position_return > 0.03"
    },
    {
     "when": "bars_held >= 2"
    }
   ],
   "risk": {
    "max_position_pct": 0.25,
    "max_positions": 4,
    "max_gross_exposure": 1.0,
    "stop_loss_pct": 0.08,
    "take_profit_pct": 0.04,
    "trailing_stop_pct": 0.0,
    "max_hold_bars": 2,
    "min_hold_bars": 0,
    "cooldown_bars": 1
   }
  },
