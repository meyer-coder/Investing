{
 "genomes": [
  {
   "name": "RSI7 Dip in Uptrend",
   "thesis": "Oversold 7-bar RSI while the fund is above its 50-day mean; out on the snap or after 3 bars.",
   "entry_rules": [
    {
     "when": "rsi7 < 25 and close > sma50",
     "weight": 0.25
    }
   ],
   "exit_rules": [
    {
     "when": "rsi7 > 55"
    },
    {
     "when": "bars_held >= 3"
    }
   ],
   "risk": {
    "max_position_pct": 0.25,
    "max_positions": 4,
    "max_gross_exposure": 1.0,
    "stop_loss_pct": 0.1,
    "take_profit_pct": 0.0,
    "trailing_stop_pct": 0.0,
    "max_hold_bars": 3,
    "min_hold_bars": 0,
    "cooldown_bars": 1
   }
  },
