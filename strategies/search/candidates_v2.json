  {
   "name": "ATR Drop",
   "thesis": "A drop of more than two ATRs near the 20-day mean; out at 1.5 ATR or two bars.",
   "entry_rules": [
    {
     "when": "ret1 < -2.0 * atr_pct and close > sma20 * 0.97",
     "weight": 0.25
