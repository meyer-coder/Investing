{
 "genomes": [
  {
   "name": "Big Red Day",
   "thesis": "Baseline: 5% down day near the 20-day mean on volume; +3% or two bars.",
   "entry_rules": [
    {
     "when": "ret1 < -0.05 and close > sma20 * 0.97 and volume_ratio > 1.2",
     "weight": 0.25
    }
   ],
   "exit_rules": [
    {
     "when": "position_return > 0.03"
    },
    {
     "when": "bars_held >= 2"
    }
   ],
   "risk": {
    "max_position_pct": 0.25,
    "max_positions": 4,
    "max_gross_exposure": 1.0,
    "stop_loss_pct": 0.08,
    "take_profit_pct": 0.04,
    "trailing_stop_pct": 0.0,
    "max_hold_bars": 2,
    "min_hold_bars": 0,
    "cooldown_bars": 1
   }
  },
  {
   "name": "Big Red Day, 1-Bar",
   "thesis": "Same entry, always out at the next open after one full bar.",
