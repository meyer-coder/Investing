  {
   "name": "Hammer Reversal",
   "thesis": "Down 3% but closing in the top 30% of the day's range, still near the 50-day.",
   "entry_rules": [
    {
     "when": "ret1 < -0.03 and (close - low) / (high - low + 0.0001) > 0.7 and close > sma50 * 0.95",
