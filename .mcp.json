{
  "mcpServers": {
    "evotrader": {
      "command": "python3",
      "args": ["-m", "evotrader.cli", "mcp"],
      "env": {
        "EVOTRADER_DB": "runs/evotrader.sqlite"
      }
    },
    "tradingview-backtest": {
      "command": "python3",
      "args": ["-m", "evotrader.cli", "tv-mcp"],
      "env": {
        "EVOTRADER_DB": "runs/evotrader.sqlite"
      }
    }
  }
}
