//@version=6
// Squeeze Days (evolved) — from evotrader, profitable-strategies/04_squeeze_days.json.
//
// Buys at the next open when the close shows any of:
//   1. squeeze breakout: 20-day volatility under 80% of 60-day volatility and a close crossing above the upper Bollinger band
//   2. two red days: yesterday down more than 2.8%, today down again, five-day return under -7.8%, close above the 50-day mean
// Exit at the open after a close up more than 2% on the day or after 2 bars;
// 6% stop checked on the close, target 8%; 0 bar(s) of cooldown.
//
// Daily bars; the signal is read on the close, the fill is the next open;
// stops and targets are checked on the close, not intrabar. The Python
// backtest runs this as a book of 20% slots across TQQQ, MUU, RIOX and
// SOXL; a Pine strategy holds one symbol, so run one chart per fund. On an
// NQ/QQQ chart set "Threshold scale" to 0.333 (the rules were tuned on 3x funds).
strategy("Squeeze Days (evolved) [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=20, commission_type=strategy.commission.percent,
     commission_value=0.01, slippage=1, process_orders_on_close=false)

scale     = input.float(1.0, "Threshold scale (1 = leveraged fund chart, 0.333 = NQ/QQQ chart)", step=0.001)
upClose   = input.float(2.0, "Exit after a close up this much on the day, %") / 100 * scale
targetPct = input.float(8.0, "Hard target, % (checked on the close)") / 100 * scale
stopPct   = input.float(6.0, "Hard stop, % (checked on the close)") / 100 * scale
maxBars   = input.int(2, "Exit after this many bars held")
cooldown  = input.int(0, "Bars to wait after an exit before re-entering")
use1 = input.bool(true, "Use setup 1: squeeze breakout")
use2 = input.bool(true, "Use setup 2: two red days")

ret1   = close / close[1] - 1
ret5   = close / close[5] - 1
sma50  = ta.sma(close, 50)
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
lr     = math.log(close / close[1])
volRatio2060 = ta.stdev(lr, 60) > 0 ? ta.stdev(lr, 20) / ta.stdev(lr, 60) : 1.0

s1 = use1 and volRatio2060 < 0.8 and ta.crossover(close, bbUp)
s2 = use2 and ret1 < 0 and ret1[1] < -0.028 * scale and close > sma50 and ret5 < -0.078 * scale
setup = s1 or s2

var int lastExitBar = -100000
var int closedSeen = 0
if strategy.closedtrades > closedSeen
    closedSeen := strategy.closedtrades
    lastExitBar := bar_index

flat     = strategy.position_size == 0
canEnter = flat and (bar_index - lastExitBar) >= cooldown

if canEnter and setup
    strategy.entry("L", strategy.long)

if not flat
    barsHeld = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    posRet   = close / strategy.position_avg_price - 1
    if posRet <= -stopPct or posRet >= targetPct or ret1 > upClose or barsHeld >= maxBars
        strategy.close("L")

plotshape(setup and canEnter, title="Setup", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.teal, 0), size=size.small)
alertcondition(setup and canEnter, "Squeeze Days (evolved): buy at next open",
     "Squeeze Days (evolved) setup on {{ticker}}: buy at the next open")
