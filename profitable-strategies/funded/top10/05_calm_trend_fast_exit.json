    "when": "zscore20 < -1.35 and close > sma200",
    "weight": 1.0,
    "note": ""
   },
   {
    "when": "cross_above(close, sma50)",
    "weight": 1.0,
    "note": ""
   }
  ],
  "exit_rules": [
   {
    "when": "vol20 > 0.5",
    "note": ""
