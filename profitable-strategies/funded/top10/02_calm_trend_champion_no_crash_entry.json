 "genome": {
  "id": "ed6af4f039af",
  "name": "Calm Trend Champion, No Crash Entry",
  "thesis": "The champion's sibling without the volatility-spike entry. Its dip entry needs a 1.23-sigma dip, its thrust entry a 5.4% week, and its trend exit tolerates a little more weakness: it sells a close under the 50-day mean only while the z-score is above -1.19. Same 4.2% stop, 7% target, 4.9% trailing stop, 13-session cap and two-session wait.",
  "entry_rules": [
   {
    "when": "ret60 <= -0.09 or cross_above(close, sma50)",
    "weight": 1.0,
    "note": "mutation: new entry"
   },
   {
    "when": "vol20 < 0.22 and dist_sma50 > 0.047",
    "weight": 1.0,
    "note": ""
   },
   {
    "when": "zscore20 < -1.23 and close > sma200 or ret5 > 0.054",
    "weight": 1.0,
    "note": ""
   }
  ],
  "exit_rules": [
   {
    "when": "vol20 > 0.45",
    "note": ""
   },
   {
    "when": "close < sma50 and zscore20 > -1.19",
    "note": ""
   },
   {
    "when": "dist_sma200 < -0.23",
    "note": "mutation: new exit"
   }
  ],
