 "genome": {
  "id": "5c483b32d9c6",
  "name": "Quieter Trend + Z-Dip",
  "thesis": "A cleaner, quieter version of the leader. Long above the 50-day mean while 20-day volatility is under 22%, after a 1.35-sigma dip above the 200-day, or on a close back over the 50-day. Out when volatility passes 50% or on a close under the 50-day that is not oversold; 4.2% stop, 7% target, 5% trailing stop, 13 sessions, two-session wait.",
  "entry_rules": [
   {
    "when": "close > sma50 and vol20 < 0.22",
    "weight": 1.0,
    "note": ""
   },
   {
    "when": "zscore20 < -1.35 and close > sma200",
    "weight": 1.0,
    "note": ""
   },
   {
    "when": "cross_above(close, sma50)",
    "weight": 1.0,
    "note": ""
   }
  ],
  "exit_rules": [
   {
    "when": "vol20 > 0.5",
    "note": ""
   },
   {
    "when": "close < sma50 and zscore20 > -1",
    "note": ""
   }
  ],
