 "genome": {
  "id": "5dc00bb8fdee",
  "name": "Calm Trend, Volume-Checked Dips",
  "thesis": "Any close above the 50-day mean with 20-day volatility under 22% counts as trend. The dip and thrust entries (a 1.2-sigma dip above the 200-day, a 5.3% week) are taken only on ordinary volume, under 1.28 times average, so it does not buy into a panic. It also buys a close back over the 50-day and a 9% 60-day slide. Out when volatility passes 50% or the index breaks the 50-day without being oversold; 4.2% stop, 7.3% target, 4.9% trailing stop, 13 sessions, two-session wait.",
  "entry_rules": [
   {
    "when": "ret60 <= -0.09 or cross_above(close, sma50)",
    "weight": 1.0,
    "note": "mutation: new entry"
   },
   {
    "when": "close > sma50 and vol20 < 0.22",
    "weight": 1.0,
    "note": ""
   },
   {
    "when": "(zscore20 < -1.18 and close > sma200 or ret5 > 0.053) and volume_ratio < 1.28",
    "weight": 1.0,
    "note": ""
   }
  ],
  "exit_rules": [
   {
    "when": "vol20 > 0.5",
    "note": ""
   },
   {
    "when": "close < sma50 and zscore20 > -1",
    "note": ""
   }
  ],
