//@version=6
// Quiet MACD Trend, same-day version: evotrader genome dd4cd9664653.
// Same-day version for FundedNext Futures, which allows no overnight holds.
// Tested on ratio back-adjusted daily bars with 0.2 bp commission and 1 bp
// slippage a side, then priced per contract ($0.75 a side plus a tick, two on
// stops). Past results; not advice.
//
// Long while the MACD histogram is positive, the index is above its 50-day
// mean and 20-day volatility is under 25%. Out when the histogram turns
// negative after at least three sessions, or after ten sessions.
//
// Rules, exactly as the engine runs them:
// BUY when macd_hist > 0 and close > sma50 and vol20 < 0.25
// SELL when macd_hist < 0 and bars_held >= 3
// The strategy's own position (checked on the close, from its first entry):
// no stop, no target, no trailing stop, max hold 10 sessions.
//
// No overnight holds, for a prop account such as FundedNext (flat by 15:10
// Chicago time). Daily MNQ1! chart, back-adjusted, settlement as close. Each
// session the position is bought at the 17:00 Chicago open with a resting
// stop 0.80% under the fill, and sold at the close; in live trading be flat
// before 15:10 Chicago time. The next session it is bought back if the
// strategy still holds it, even after a stopped day.
// For MES instead: take the same signals from this NQ chart and buy one MES
// with a 1% daily stop under its fill.
strategy("Quiet MACD Trend [evotrader, same-day]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.75,
     slippage=1, process_orders_on_close=false)

contracts  = input.int(1, "Contracts", minval=1)
dayStopPct = input.float(0.8, "Daily stop, % under each day's entry (0 = off)") / 100
stopPct    = input.float(0, "Strategy stop, % below its first entry, on the close (0 = off)") / 100
targetPct  = input.float(0, "Strategy target, % above its first entry, on the close (0 = off)") / 100
trailPct   = input.float(0, "Trailing stop, % off the best close (0 = off)") / 100
maxHold    = input.int(10, "Max sessions held (0 = off)")
minHold    = input.int(0, "Min sessions before the sell rules apply")
cooldown   = input.int(0, "Sessions to wait after the strategy exits")

// ---- the session ends: nothing is held past the close
if strategy.position_size > 0
    strategy.close_all(comment="flat at the close", immediately=true)

// ---- the strategy's own position, carried from day to day
var bool  book        = false
var int   bookBar     = na
var float bookEntry   = na
var float bookPeak    = na
var int   lastExitBar = -100000
if book and bar_index >= bookBar
    if na(bookEntry)
        bookEntry := open
    bookPeak := math.max(na(bookPeak) ? bookEntry : bookPeak, close)

// ---- features (evotrader's definitions)
[f_macd, f_macd_signal, f_macd_hist] = ta.macd(close, 12, 26, 9)
f_bars_held = book ? bar_index - bookBar : 0
f_sma50 = ta.sma(close, 50)
f_ret1 = close / close[1] - 1
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)

warm = bar_index >= 50
buySignal = ((((f_macd_hist > 0.0) and (close > f_sma50)) and (f_vol20 < 0.25)))
sellSignal = (((f_macd_hist < 0.0) and (f_bars_held >= 3.0)))
exitNow = false
if book and bar_index >= bookBar
    held = bar_index - bookBar
    posRet = close / bookEntry - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (trailPct > 0 and close / bookPeak - 1 <= -trailPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        book := false
        bookEntry := na
        bookPeak := na
        lastExitBar := bar_index + 1
        exitNow := true
enterNow = warm and not book and not exitNow and (cooldown <= 0 or bar_index - lastExitBar >= cooldown) and buySignal
if enterNow
    book := true
    bookBar := bar_index + 1

// ---- tomorrow's session: buy at the open, a resting stop under the fill
if book
    strategy.entry("L", strategy.long, qty=contracts, comment=enterNow ? "in" : "back in")
    if dayStopPct > 0
        strategy.exit("day stop", "L", loss=math.max(1, math.round(dayStopPct * close / syminfo.mintick)), comment="day stop")

plotshape(enterNow, title="Position starts at the next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Position ends: stay flat", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(book, "Quiet MACD Trend: buy at the next open", "Quiet MACD Trend: buy {{ticker}} at the 17:00 Chicago open with the daily stop; flat by 15:10")
alertcondition(exitNow, "Quiet MACD Trend: position ends", "Quiet MACD Trend: the strategy is out; do not buy {{ticker}} at the next open")
