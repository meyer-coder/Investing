//@version=6
// SOXL / NVDL / AMDL / AVGX / TSMX / MUU Five-Day Pullback: 6% target, 3% stop, 10 — evotrader genome acd11c9daaed.
// Leveraged tech strategy 38 of the grind (strategies/etf).
//
// Five-Day Pullback, Reward 0.06/0.03/10
//
// Rules, exactly as the engine runs them:
// BUY when ret5 < -0.08 and close > sma200
// SELL when bars_held >= 10
// Risk (checked on the close, filled at the next open): stop 3.00%, target
// 6.00%, no trailing stop, no max hold.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a daily MUU chart. The backtests put the whole $25,000 account in each
// trade, one position at a time.
// Alerts: add an alert on this script with the condition "alert() function
// calls only" to be told at each daily close what to do at the next open.
// Part of a 6-fund strategy (SOXL, NVDL, AMDL, AVGX, TSMX, MUU): run the
// script on each fund's chart and hold one position at a time, the first
// signal wins.
strategy("SOXL / NVDL / AMDL / AVGX / TSMX / MUU Five-Day Pullback: 6% [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=1, process_orders_on_close=false)

stopPct   = input.float(3, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(6, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(0, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_bars_held = strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
f_ret5 = close / close[5] - 1
f_sma200 = ta.sma(close, 200)

warm = bar_index >= 200
inPos = strategy.position_size > 0
buySignal = (((f_ret5 < (-0.08)) and (close > f_sma200)))
sellSignal = ((f_bars_held >= 10.0))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out", alert_message="SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: sell " + syminfo.ticker + " at the next open")
        alert("SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: sell " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, comment="in", alert_message="SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: buy " + syminfo.ticker + " at the next open")
    alert("SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: buy " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: buy at next open", "SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: buy {{ticker}} at the next open")
alertcondition(exitNow, "SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: sell at next open", "SOXL / NVDL / AMDL / AVGX / TSMX / MUU F: sell {{ticker}} at the next open")
