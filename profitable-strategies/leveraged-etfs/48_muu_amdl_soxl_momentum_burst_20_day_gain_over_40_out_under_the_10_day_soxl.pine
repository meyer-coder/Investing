//@version=6
// MUU / AMDL / SOXL Momentum Burst: 20-day gain over 40%, out under the 10-day — evotrader genome c55bce4020b4.
// Leveraged tech strategy 48 of the grind (strategies/etf).
//
// Momentum Burst 0.4/10
//
// Rules, exactly as the engine runs them:
// BUY when ret20 > 0.4 and close > sma10
// SELL when close < sma10
// Risk (checked on the close, filled at the next open): stop 10.00%, no
// target, trailing 15.00%, no max hold.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a daily SOXL chart. The backtests put the whole $25,000 account in each
// trade, one position at a time.
// Part of a 3-fund strategy (MUU, AMDL, SOXL): run the script on each fund's
// chart and hold one position at a time, the first signal wins.
strategy("MUU / AMDL / SOXL Momentum Burst: 20-day gain over 40%, out  [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=1, process_orders_on_close=false)

stopPct   = input.float(10, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(0, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(15, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(0, "Bars to wait after an exit")

// ---- state the rules can read
var float posPeak = na
if strategy.position_size > 0
    posPeak := na(posPeak) or strategy.opentrades.entry_bar_index(0) == bar_index ? math.max(strategy.position_avg_price, close) : math.max(posPeak, close)
else
    posPeak := na
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_position_drawdown = strategy.position_size > 0 ? math.min(close / posPeak - 1, 0.0) : 0.0
f_ret20 = close / close[20] - 1
f_sma10 = ta.sma(close, 10)

warm = bar_index >= 20
inPos = strategy.position_size > 0
buySignal = (((f_ret20 > 0.4) and (close > f_sma10)))
sellSignal = ((close < f_sma10))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (trailPct > 0 and f_position_drawdown <= -trailPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out")
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, comment="in")

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "MUU / AMDL / SOXL Momentum Burst: 20-day: buy at next open", "MUU / AMDL / SOXL Momentum Burst: 20-day: buy {{ticker}} at the next open")
alertcondition(exitNow, "MUU / AMDL / SOXL Momentum Burst: 20-day: sell at next open", "MUU / AMDL / SOXL Momentum Burst: 20-day: sell {{ticker}} at the next open")
