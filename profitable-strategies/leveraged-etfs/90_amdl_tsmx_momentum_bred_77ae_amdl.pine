//@version=6
// AMDL / TSMX Momentum (bred 77AE) — evotrader genome d8776ce0041b.
// Leveraged tech strategy 90 of the grind (strategies/etf).
//
// randomly generated; no prior belief
//
// Rules, exactly as the engine runs them:
// BUY when dist_sma200 > -0.255 and volume_ratio <= 1.24 and atr_pct > 0.0235
// or volume_ratio > 2.39 or cross_above(macd, macd_signal)
// SELL when atr_pct < 0.0438
// SELL when vol_ratio_20_60 > 1.46
// Risk (checked on the close, filled at the next open): stop 5.00%, target
// 30.00%, no trailing stop, no max hold, min hold 5 bars, cooldown 2 bars.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a daily AMDL chart. The backtests put the whole $25,000 account in each
// trade, one position at a time.
// Alerts: add an alert on this script with the condition "alert() function
// calls only" to be told at each daily close what to do at the next open.
// Part of a 2-fund strategy (AMDL, TSMX): run the script on each fund's chart
// and hold one position at a time, the first signal wins.
strategy("AMDL / TSMX Momentum (bred 77AE) [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=1, process_orders_on_close=false)

stopPct   = input.float(5, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(30, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(5, "Min bars before the sell rules apply")
cooldown  = input.int(2, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
[f_macd, f_macd_signal, f_macd_hist] = ta.macd(close, 12, 26, 9)
f_atr14 = ta.atr(14)
f_atr_pct = f_atr14 / close
f_sma200 = ta.sma(close, 200)
f_dist_sma200 = close / f_sma200 - 1
f_ret1 = close / close[1] - 1
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)
f_vol60 = ta.stdev(f_ret1, 60, false) * math.sqrt(252)
f_vol_ratio_20_60 = f_vol60 > 0 ? f_vol20 / f_vol60 : 1.0
f_volavg20 = ta.sma(volume, 20)
f_volume_ratio = f_volavg20 > 0 ? volume / f_volavg20 : 1.0

warm = bar_index >= 200
inPos = strategy.position_size > 0
buySignal = ((((((f_dist_sma200 > (-0.255)) and (f_volume_ratio <= 1.24)) and (f_atr_pct > 0.0235)) or (f_volume_ratio > 2.39)) or (f_macd > f_macd_signal and f_macd[1] <= f_macd_signal[1])))
sellSignal = ((f_atr_pct < 0.0438)) or ((f_vol_ratio_20_60 > 1.46))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out", alert_message="AMDL / TSMX Momentum (bred 77AE): sell " + syminfo.ticker + " at the next open")
        alert("AMDL / TSMX Momentum (bred 77AE): sell " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, comment="in", alert_message="AMDL / TSMX Momentum (bred 77AE): buy " + syminfo.ticker + " at the next open")
    alert("AMDL / TSMX Momentum (bred 77AE): buy " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "AMDL / TSMX Momentum (bred 77AE): buy at next open", "AMDL / TSMX Momentum (bred 77AE): buy {{ticker}} at the next open")
alertcondition(exitNow, "AMDL / TSMX Momentum (bred 77AE): sell at next open", "AMDL / TSMX Momentum (bred 77AE): sell {{ticker}} at the next open")
