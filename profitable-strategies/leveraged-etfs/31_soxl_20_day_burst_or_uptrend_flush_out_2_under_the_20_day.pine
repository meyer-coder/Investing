//@version=6
// SOXL 20-Day Burst or Uptrend Flush, out 2% under the 20-day — evotrader genome 934c4897b721.
// Leveraged tech strategy 31 of the grind (strategies/etf).
//
// 20-Day Burst or Uptrend Flush 0.02
//
// Rules, exactly as the engine runs them:
// BUY when ret20 > 0.2 and close > sma10
// BUY when ret1 < -0.05 and close > sma50
// SELL when dist_sma20 < -0.02
// Risk (checked on the close, filled at the next open): stop 12.00%, no
// target, no trailing stop, no max hold, cooldown 3 bars.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a daily SOXL chart. The backtests put the whole $25,000 account in each
// trade, one position at a time.
// Alerts: add an alert on this script with the condition "alert() function
// calls only" to be told at each daily close what to do at the next open.
strategy("SOXL 20-Day Burst or Uptrend Flush, out 2% under the 20-day [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=1, process_orders_on_close=false)

stopPct   = input.float(12, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(0, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(3, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_sma20 = ta.sma(close, 20)
f_dist_sma20 = close / f_sma20 - 1
f_ret1 = close / close[1] - 1
f_ret20 = close / close[20] - 1
f_sma10 = ta.sma(close, 10)
f_sma50 = ta.sma(close, 50)

warm = bar_index >= 50
inPos = strategy.position_size > 0
buySignal = (((f_ret20 > 0.2) and (close > f_sma10))) or (((f_ret1 < (-0.05)) and (close > f_sma50)))
sellSignal = ((f_dist_sma20 < (-0.02)))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out", alert_message="SOXL 20-Day Burst or Uptrend Flush, out : sell " + syminfo.ticker + " at the next open")
        alert("SOXL 20-Day Burst or Uptrend Flush, out : sell " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, comment="in", alert_message="SOXL 20-Day Burst or Uptrend Flush, out : buy " + syminfo.ticker + " at the next open")
    alert("SOXL 20-Day Burst or Uptrend Flush, out : buy " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "SOXL 20-Day Burst or Uptrend Flush, out : buy at next open", "SOXL 20-Day Burst or Uptrend Flush, out : buy {{ticker}} at the next open")
alertcondition(exitNow, "SOXL 20-Day Burst or Uptrend Flush, out : sell at next open", "SOXL 20-Day Burst or Uptrend Flush, out : sell {{ticker}} at the next open")
