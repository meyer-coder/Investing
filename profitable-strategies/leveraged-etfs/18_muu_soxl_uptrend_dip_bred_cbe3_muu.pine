//@version=6
// MUU / SOXL Uptrend Dip (bred CBE3) — evotrader genome 50c9f059d3b7.
// Leveraged tech strategy 18 of the grind (strategies/etf).
//
// Rarely trade; buy deep drawdowns and hold for months. Combined with: Quiet
// markets precede expansion; buy the squeeze.
//
// Rules, exactly as the engine runs them:
// BUY when dist_sma200 > -0.08 and rsi14 < 37
// BUY when ret1 < -0.01 and vol_ratio_20_60 > 1.43 and bb_pct > 0.5
// BUY when vol_ratio_20_60 < 0.75 and close > sma50 or pct_of_52w_high >
// 0.855
// SELL when mkt_vol20 < 0.499
// SELL when position_return > 0.25
// Risk (checked on the close, filled at the next open): no stop, no target,
// trailing 8.00%, no max hold, min hold 10 bars.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a daily MUU chart. The backtests put the whole $25,000 account in each
// trade, one position at a time.
// Alerts: add an alert on this script with the condition "alert() function
// calls only" to be told at each daily close what to do at the next open.
// Part of a 2-fund strategy (MUU, SOXL): run the script on each fund's chart
// and hold one position at a time, the first signal wins.
strategy("MUU / SOXL Uptrend Dip (bred CBE3) [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=1, process_orders_on_close=false)

stopPct   = input.float(0, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(0, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(8, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(10, "Min bars before the sell rules apply")
cooldown  = input.int(0, "Bars to wait after an exit")

// ---- state the rules can read
var float posPeak = na
if strategy.position_size > 0
    posPeak := na(posPeak) or strategy.opentrades.entry_bar_index(0) == bar_index ? math.max(strategy.position_avg_price, close) : math.max(posPeak, close)
else
    posPeak := na
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_sma20 = ta.sma(close, 20)
f_sd20 = ta.stdev(close, 20, false)
f_bb_upper = f_sma20 + 2 * f_sd20
f_bb_lower = f_sma20 - 2 * f_sd20
f_bb_pct = f_bb_upper - f_bb_lower > 0 ? (close - f_bb_lower) / (f_bb_upper - f_bb_lower) : 0.5
f_sma200 = ta.sma(close, 200)
f_dist_sma200 = close / f_sma200 - 1
f_ret1 = close / close[1] - 1
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)
f_mkt_vol20 = f_vol20
f_pct_of_52w_high = close / ta.highest(close, 252)
f_position_drawdown = strategy.position_size > 0 ? math.min(close / posPeak - 1, 0.0) : 0.0
f_position_return = strategy.position_size > 0 ? close / strategy.position_avg_price - 1 : 0.0
f_rsi14 = ta.rsi(close, 14)
f_sma50 = ta.sma(close, 50)
f_vol60 = ta.stdev(f_ret1, 60, false) * math.sqrt(252)
f_vol_ratio_20_60 = f_vol60 > 0 ? f_vol20 / f_vol60 : 1.0

warm = bar_index >= 252
inPos = strategy.position_size > 0
buySignal = (((f_dist_sma200 > (-0.08)) and (f_rsi14 < 37.0))) or ((((f_ret1 < (-0.01)) and (f_vol_ratio_20_60 > 1.43)) and (f_bb_pct > 0.5))) or ((((f_vol_ratio_20_60 < 0.75) and (close > f_sma50)) or (f_pct_of_52w_high > 0.855)))
sellSignal = ((f_mkt_vol20 < 0.499)) or ((f_position_return > 0.25))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (trailPct > 0 and f_position_drawdown <= -trailPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out", alert_message="MUU / SOXL Uptrend Dip (bred CBE3): sell " + syminfo.ticker + " at the next open")
        alert("MUU / SOXL Uptrend Dip (bred CBE3): sell " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, comment="in", alert_message="MUU / SOXL Uptrend Dip (bred CBE3): buy " + syminfo.ticker + " at the next open")
    alert("MUU / SOXL Uptrend Dip (bred CBE3): buy " + syminfo.ticker + " at the next open", alert.freq_once_per_bar_close)

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "MUU / SOXL Uptrend Dip (bred CBE3): buy at next open", "MUU / SOXL Uptrend Dip (bred CBE3): buy {{ticker}} at the next open")
alertcondition(exitNow, "MUU / SOXL Uptrend Dip (bred CBE3): sell at next open", "MUU / SOXL Uptrend Dip (bred CBE3): sell {{ticker}} at the next open")
