//@version=6
// AMDL Uptrend Dip (bred 852D) — evotrader genome 3f61875c5ba4.
// Leveraged tech strategy 12 of the grind (strategies/etf).
//
// A big down day closing near its low on volume. Combined with: Two down days
// in an uptrend, sold on the first green close. Combined with: Two down days
// in an uptrend, sold on the first green close. Combined with: A big down day
// closing near its low on volume. Combined with: Two down days in an uptrend,
// sold on the first green close. Combined with: A big down day closing near
// its low on volume.
//
// Rules, exactly as the engine runs them:
// BUY when (ret1 < -0.06 and (close - low) / (high - low + 0.0001) < 0.28 and
// volume_ratio > 1.71 or cross_below(sma20, sma50)) and ret1 < 0.04
// BUY when dist_sma200 > -0.2 and rsi14 > 64 and vol_ratio_20_60 < 1.37
// BUY when ret1 < 0.03 and prev(ret1) < 0.004 and close > sma50 and rsi7 < 58
// BUY when ret5 < 0.052 and vol_ratio_20_60 > 1.31 and dist_sma200 < -0.24 or
// atr_pct < 0.0514 or rsi7 > 76
// SELL when ret1 > 0.02
// SELL when position_return > 0.04
// SELL when bars_held >= 2
// Risk (checked on the close, filled at the next open): stop 12.00%, no
// target, no trailing stop, no max hold.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a daily AMDL chart. The backtests put the whole $25,000 account in each
// trade, one position at a time.
strategy("AMDL Uptrend Dip (bred 852D) [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=1, process_orders_on_close=false)

stopPct   = input.float(12, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(0, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(0, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_atr14 = ta.atr(14)
f_atr_pct = f_atr14 / close
f_bars_held = strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
f_sma200 = ta.sma(close, 200)
f_dist_sma200 = close / f_sma200 - 1
f_position_return = strategy.position_size > 0 ? close / strategy.position_avg_price - 1 : 0.0
f_ret1 = close / close[1] - 1
f_ret5 = close / close[5] - 1
f_rsi14 = ta.rsi(close, 14)
f_rsi7 = ta.rsi(close, 7)
f_sma20 = ta.sma(close, 20)
f_sma50 = ta.sma(close, 50)
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)
f_vol60 = ta.stdev(f_ret1, 60, false) * math.sqrt(252)
f_vol_ratio_20_60 = f_vol60 > 0 ? f_vol20 / f_vol60 : 1.0
f_volavg20 = ta.sma(volume, 20)
f_volume_ratio = f_volavg20 > 0 ? volume / f_volavg20 : 1.0

warm = bar_index >= 200
inPos = strategy.position_size > 0
buySignal = ((((((f_ret1 < (-0.06)) and ((((high - low) + 0.0001) != 0 ? (close - low) / ((high - low) + 0.0001) : 0.0) < 0.28)) and (f_volume_ratio > 1.71)) or (f_sma20 < f_sma50 and f_sma20[1] >= f_sma50[1])) and (f_ret1 < 0.04))) or ((((f_dist_sma200 > (-0.2)) and (f_rsi14 > 64.0)) and (f_vol_ratio_20_60 < 1.37))) or (((((f_ret1 < 0.03) and (f_ret1[1] < 0.004)) and (close > f_sma50)) and (f_rsi7 < 58.0))) or ((((((f_ret5 < 0.052) and (f_vol_ratio_20_60 > 1.31)) and (f_dist_sma200 < (-0.24))) or (f_atr_pct < 0.0514)) or (f_rsi7 > 76.0)))
sellSignal = ((f_ret1 > 0.02)) or ((f_position_return > 0.04)) or ((f_bars_held >= 2.0))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out")
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, comment="in")

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "AMDL Uptrend Dip (bred 852D): buy at next open", "AMDL Uptrend Dip (bred 852D): buy {{ticker}} at the next open")
alertcondition(exitNow, "AMDL Uptrend Dip (bred 852D): sell at next open", "AMDL Uptrend Dip (bred 852D): sell {{ticker}} at the next open")
