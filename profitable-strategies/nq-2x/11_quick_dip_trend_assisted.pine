//@version=6
// Quick Dip, Trend-Assisted — evotrader genome 229156892a25.
// From evotrader,
// profitable-strategies/nq-2x/11_quick_dip_trend_assisted.json. NQ E-mini,
// long only, twice the account in notional; bred over generations, judged on
// the last six months held out (2026-03-23 to 2026-09-22).
//
// One- and two-session trades. It buys a 2% drop above the 200-day mean, a
// close back over the 50-day, a 5.2% 20-day run while volatility is under
// 50%, the day after a 1% drop inside a 1.5% five-day dip above the 50-day
// (or any day more than 15.6% above the 200-day) when the close is not
// stretched above its 20-day mean, and a close through the upper Bollinger
// band. It sells after two sessions, on the first 0.5% up day, or on a close
// 1.8% under the 20-day mean; 3.5% stop.
//
// Rules, exactly as the engine runs them:
// BUY when ret1 <= -0.02 and close > sma200 or cross_above(close, sma50)
// BUY when mkt_ret20 > 0.052 and mkt_vol20 < 0.5
// BUY when (prev(ret1) < -0.01 and ret5 < -0.015 and close > sma50 or
// dist_sma200 > 0.156) and zscore20 < 0.58
// BUY when cross_above(close, bb_upper)
// SELL when bars_held >= 2
// SELL when ret1 > 0.005
// SELL when dist_sma20 < -0.018
// Risk (checked on the close, filled at the next open): stop 3.50%, no
// target, no trailing stop, no max hold.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a MNQ1! (micro) chart with back-adjustment on. The backtests run at twice a
// $25,000 account in notional, about 0.8 MNQ at NQ 31,000; one MNQ is about
// 2.5x, so the default of one contract is a little more than the tested size.
strategy("Quick Dip, Trend-Assisted [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=1.0,
     slippage=1, process_orders_on_close=false)

contracts = input.int(1, "Contracts", minval=1)
stopPct   = input.float(3.5, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(0, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(0, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_bars_held = strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
f_sma20 = ta.sma(close, 20)
f_sd20 = ta.stdev(close, 20, false)
f_bb_upper = f_sma20 + 2 * f_sd20
f_dist_sma20 = close / f_sma20 - 1
f_sma200 = ta.sma(close, 200)
f_dist_sma200 = close / f_sma200 - 1
f_mkt_ret20 = close / close[20] - 1
f_ret1 = close / close[1] - 1
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)
f_mkt_vol20 = f_vol20
f_ret5 = close / close[5] - 1
f_sma50 = ta.sma(close, 50)
f_zscore20 = f_sd20 > 0 ? (close - f_sma20) / f_sd20 : 0.0

warm = bar_index >= 200
inPos = strategy.position_size > 0
buySignal = ((((f_ret1 <= (-0.02)) and (close > f_sma200)) or (close > f_sma50 and close[1] <= f_sma50[1]))) or (((f_mkt_ret20 > 0.052) and (f_mkt_vol20 < 0.5))) or ((((((f_ret1[1] < (-0.01)) and (f_ret5 < (-0.015))) and (close > f_sma50)) or (f_dist_sma200 > 0.156)) and (f_zscore20 < 0.58))) or ((close > f_bb_upper and close[1] <= f_bb_upper[1]))
sellSignal = ((f_bars_held >= 2.0)) or ((f_ret1 > 0.005)) or ((f_dist_sma20 < (-0.018)))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out")
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, qty=contracts, comment="in")

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "Quick Dip, Trend-Assisted: buy at next open", "Quick Dip, Trend-Assisted: buy {{ticker}} at the next open")
alertcondition(exitNow, "Quick Dip, Trend-Assisted: sell at next open", "Quick Dip, Trend-Assisted: sell {{ticker}} at the next open")
