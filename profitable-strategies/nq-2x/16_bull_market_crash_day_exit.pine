//@version=6
// Bull Market, Crash-Day Exit — evotrader genome 1ae16b0bd872.
// From evotrader,
// profitable-strategies/nq-2x/16_bull_market_crash_day_exit.json. NQ E-mini,
// long only, twice the account in notional; bred over generations, judged on
// the last six months held out (2026-03-23 to 2026-09-22).
//
// Long above the 200-day mean while 20-day volatility is under 30% and the
// day did not fall 1.5%. It steps out after any 1.5% down day and is back as
// soon as the conditions hold again; ten sessions at most per trade, no stop.
//
// Rules, exactly as the engine runs them:
// BUY when close > sma200 and ret1 > -0.015 and vol20 < 0.3
// SELL when ret1 < -0.015
// Risk (checked on the close, filled at the next open): no stop, no target,
// no trailing stop, max hold 10 bars.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a MNQ1! (micro) chart with back-adjustment on. The backtests run at twice a
// $25,000 account in notional, about 0.8 MNQ at NQ 31,000; one MNQ is about
// 2.5x, so the default of one contract is a little more than the tested size.
strategy("Bull Market, Crash-Day Exit [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=1.0,
     slippage=1, process_orders_on_close=false)

contracts = input.int(1, "Contracts", minval=1)
stopPct   = input.float(0, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(0, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(10, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(0, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
f_ret1 = close / close[1] - 1
f_sma200 = ta.sma(close, 200)
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)

warm = bar_index >= 200
inPos = strategy.position_size > 0
buySignal = ((((close > f_sma200) and (f_ret1 > (-0.015))) and (f_vol20 < 0.3)))
sellSignal = ((f_ret1 < (-0.015)))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out")
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, qty=contracts, comment="in")

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "Bull Market, Crash-Day Exit: buy at next open", "Bull Market, Crash-Day Exit: buy {{ticker}} at the next open")
alertcondition(exitNow, "Bull Market, Crash-Day Exit: sell at next open", "Bull Market, Crash-Day Exit: sell {{ticker}} at the next open")
