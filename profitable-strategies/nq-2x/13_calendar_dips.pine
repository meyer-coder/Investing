//@version=6
// Calendar Dips — evotrader genome 0e0e0b03ecc5.
// From evotrader, profitable-strategies/nq-2x/13_calendar_dips.json. NQ
// E-mini, long only, twice the account in notional; bred over generations,
// judged on the last six months held out (2026-03-23 to 2026-09-22).
//
// Trades of one or two sessions timed by the calendar. It buys a 1.5%
// five-day dip after the 10th of the month above the 200-day with the close
// within 2% of its 20-day mean; a red Friday while less than 50% above the
// 52-week low; a 1.3% dip between the 13th and the 23rd above the 200-day, or
// any 14% 20-day run; a MACD bullish cross with RSI(7) under 49, or a close
// in the top fifth of the Bollinger band. It sells after one session, and
// sooner in the first five days of a month, on a quiet low-volume day that is
// not oversold, or on a MACD slide 7.6% under the 200-day; 3% stop, 2.5%
// target, one-session wait.
//
// Rules, exactly as the engine runs them:
// BUY when day_of_month >= 11 and ret5 < -0.015 and close > sma200 and
// dist_sma20 > -0.02
// BUY when day_of_week == 4 and ret1 < -0.002 and pct_off_52w_low < 0.5
// BUY when day_of_month >= 13 and day_of_month < 24 and ret5 < -0.013 and
// close > sma200 and dist_sma20 > -0.05 or ret20 > 0.14
// BUY when cross_above(macd, macd_signal) and rsi7 < 49 or bb_pct > 0.8
// SELL when bars_held >= 1
// SELL when macd_hist < -0.4 and dist_sma200 < -0.076
// SELL when day_of_month <= 5
// SELL when vol_ratio_20_60 < 1.45 and zscore20 > -0.95 and volume_ratio <
// 1.03
// Risk (checked on the close, filled at the next open): stop 3.00%, target
// 2.50%, no trailing stop, no max hold, cooldown 1 bars.
//
// Daily bars; the signal is read on the close and fills at the next open. Use
// a MNQ1! (micro) chart with back-adjustment on. The backtests run at twice a
// $25,000 account in notional, about 0.8 MNQ at NQ 31,000; one MNQ is about
// 2.5x, so the default of one contract is a little more than the tested size.
strategy("Calendar Dips [evotrader]", overlay=true, pyramiding=0,
     initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=1.0,
     slippage=1, process_orders_on_close=false)

contracts = input.int(1, "Contracts", minval=1)
stopPct   = input.float(3, "Stop, % below entry (0 = off)") / 100
targetPct = input.float(2.5, "Target, % above entry (0 = off)") / 100
trailPct  = input.float(0, "Trailing stop, % off the peak close (0 = off)") / 100
maxHold   = input.int(0, "Max bars held (0 = off)")
minHold   = input.int(0, "Min bars before the sell rules apply")
cooldown  = input.int(1, "Bars to wait after an exit")

// ---- state the rules can read
var int lastExitBar = -100000
if strategy.closedtrades > 0
    lastExitBar := strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)

// ---- features (evotrader's definitions)
[f_macd, f_macd_signal, f_macd_hist] = ta.macd(close, 12, 26, 9)
f_bars_held = strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
f_sma20 = ta.sma(close, 20)
f_sd20 = ta.stdev(close, 20, false)
f_bb_upper = f_sma20 + 2 * f_sd20
f_bb_lower = f_sma20 - 2 * f_sd20
f_bb_pct = f_bb_upper - f_bb_lower > 0 ? (close - f_bb_lower) / (f_bb_upper - f_bb_lower) : 0.5
f_day_of_month = dayofmonth(time_tradingday)
f_day_of_week = (dayofweek(time_tradingday) + 5) % 7
f_dist_sma20 = close / f_sma20 - 1
f_sma200 = ta.sma(close, 200)
f_dist_sma200 = close / f_sma200 - 1
f_pct_off_52w_low = close / ta.lowest(close, 252) - 1
f_ret1 = close / close[1] - 1
f_ret20 = close / close[20] - 1
f_ret5 = close / close[5] - 1
f_rsi7 = ta.rsi(close, 7)
f_vol20 = ta.stdev(f_ret1, 20, false) * math.sqrt(252)
f_vol60 = ta.stdev(f_ret1, 60, false) * math.sqrt(252)
f_vol_ratio_20_60 = f_vol60 > 0 ? f_vol20 / f_vol60 : 1.0
f_volavg20 = ta.sma(volume, 20)
f_volume_ratio = f_volavg20 > 0 ? volume / f_volavg20 : 1.0
f_zscore20 = f_sd20 > 0 ? (close - f_sma20) / f_sd20 : 0.0

warm = bar_index >= 252
inPos = strategy.position_size > 0
buySignal = (((((f_day_of_month >= 11.0) and (f_ret5 < (-0.015))) and (close > f_sma200)) and (f_dist_sma20 > (-0.02)))) or ((((math.abs(f_day_of_week - 4.0) <= 1e-9) and (f_ret1 < (-0.002))) and (f_pct_off_52w_low < 0.5))) or (((((((f_day_of_month >= 13.0) and (f_day_of_month < 24.0)) and (f_ret5 < (-0.013))) and (close > f_sma200)) and (f_dist_sma20 > (-0.05))) or (f_ret20 > 0.14))) or ((((f_macd > f_macd_signal and f_macd[1] <= f_macd_signal[1]) and (f_rsi7 < 49.0)) or (f_bb_pct > 0.8)))
sellSignal = ((f_bars_held >= 1.0)) or (((f_macd_hist < (-0.4)) and (f_dist_sma200 < (-0.076)))) or ((f_day_of_month <= 5.0)) or ((((f_vol_ratio_20_60 < 1.45) and (f_zscore20 > (-0.95))) and (f_volume_ratio < 1.03)))
exitNow = false
if inPos
    held = bar_index - strategy.opentrades.entry_bar_index(0)
    posRet = close / strategy.position_avg_price - 1
    riskExit = (stopPct > 0 and posRet <= -stopPct) or (targetPct > 0 and posRet >= targetPct) or (maxHold > 0 and held >= maxHold)
    if riskExit or (held >= minHold and sellSignal)
        strategy.close("L", comment="out")
        exitNow := true
canEnter = warm and not inPos and (cooldown <= 0 or bar_index - lastExitBar >= cooldown)
if canEnter and buySignal
    strategy.entry("L", strategy.long, qty=contracts, comment="in")

plotshape(canEnter and buySignal, title="Buy at next open", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small)
plotshape(exitNow, title="Sell at next open", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)
alertcondition(canEnter and buySignal, "Calendar Dips: buy at next open", "Calendar Dips: buy {{ticker}} at the next open")
alertcondition(exitNow, "Calendar Dips: sell at next open", "Calendar Dips: sell {{ticker}} at the next open")
