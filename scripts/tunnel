#!/usr/bin/env bash
# tunnel — bring the MCP server and its Cloudflare tunnel up, and set itself up
# the first time it runs.
#
#   tunnel           start everything (sets up on first run), print the URL
#   tunnel stop      stop both
#   tunnel status    what is running, and whether the public URL answers
#   tunnel url       print the connector URL
#   tunnel setup     change the saved settings
#   tunnel install   add the `tunnel` command to your shell
#
# Both processes are started detached, so closing the terminal does not kill
# them.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="${MCP_TUNNEL_CONFIG:-$HOME/.mcp-tunnel.conf}"
LOG_DIR="${LOG_DIR:-$HOME/.evotrader}"

say()  { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

load_config() {
    # Repo defaults, then this machine's overrides, then the environment —
    # which means holding the environment aside while the files are sourced,
    # since a plain assignment in a file would otherwise clobber it.
    # Nothing here prompts: `tunnel` should never need an answer to start.
    local env_host="${TUNNEL_HOSTNAME:-}" env_name="${TUNNEL_NAME:-}"
    local env_server="${SERVER:-}" env_port="${PORT:-}" env_endpoint="${ENDPOINT:-}"
    # shellcheck disable=SC1090
    [ -f "$REPO_DIR/tunnel.conf" ] && . "$REPO_DIR/tunnel.conf"
    # shellcheck disable=SC1090
    [ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
    [ -n "$env_host" ] && TUNNEL_HOSTNAME="$env_host"
    [ -n "$env_name" ] && TUNNEL_NAME="$env_name"
    [ -n "$env_server" ] && SERVER="$env_server"
    [ -n "$env_port" ] && PORT="$env_port"
    [ -n "$env_endpoint" ] && ENDPOINT="$env_endpoint"
    PORT="${PORT:-8787}"
    ENDPOINT="${ENDPOINT:-/mcp}"
    SERVER="${SERVER:-tradingview}"
    TUNNEL_NAME="${TUNNEL_NAME:-evotrader}"
    TUNNEL_HOSTNAME="${TUNNEL_HOSTNAME:-}"
    return 0
}

public_url() {
    # Always succeeds: a function that ends on a failing test takes its caller
    # down with it under `set -e`, silently.
    if [ -n "${TUNNEL_HOSTNAME:-}" ]; then
        printf 'https://%s%s' "$TUNNEL_HOSTNAME" "$ENDPOINT"
    else
        local url
        url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' \
              "$LOG_DIR/tunnel.log" 2>/dev/null | head -1 || true)
        [ -n "$url" ] && printf '%s%s' "$url" "$ENDPOINT"
    fi
    return 0
}

alive() { [ -f "$LOG_DIR/$1.pid" ] && kill -0 "$(cat "$LOG_DIR/$1.pid")" 2>/dev/null; }

# ------------------------------------------------------------------- setup

cmd_setup() {
    say "Changing this machine's settings. Enter keeps the current value."
    say ""
    local hostname name port server
    read -r -p "Permanent hostname (blank = a new random URL each run): " hostname
    if [ -n "$hostname" ]; then
        read -r -p "Cloudflare tunnel name [${TUNNEL_NAME:-evotrader}]: " name
        name="${name:-${TUNNEL_NAME:-evotrader}}"
    fi
    read -r -p "Which server — tradingview, training or both [${SERVER:-tradingview}]: " server
    read -r -p "Port [${PORT:-8787}]: " port

    cat > "$CONFIG_FILE" <<EOF
# written by \`tunnel setup\`
TUNNEL_HOSTNAME="${hostname}"
TUNNEL_NAME="${name:-evotrader}"
SERVER="${server:-${SERVER:-tradingview}}"
PORT="${port:-${PORT:-8787}}"
ENDPOINT="${ENDPOINT:-/mcp}"
EOF
    say ""
    say "saved to $CONFIG_FILE (this machine only; repo defaults are in tunnel.conf)"
    if [ -n "$hostname" ]; then
        say ""
        say "If you have not created that tunnel yet, once only:"
        say "  cloudflared tunnel login"
        say "  cloudflared tunnel create ${name:-evotrader}"
        say "  cloudflared tunnel route dns ${name:-evotrader} $hostname"
    fi
}

ensure_deps() {
    command -v python3 >/dev/null || die "python3 is not installed"
    if ! python3 -c "import numpy" >/dev/null 2>&1; then
        say "installing numpy..."
        pip3 install --quiet numpy || die "could not install numpy"
    fi
    if ! command -v cloudflared >/dev/null; then
        command -v brew >/dev/null || die "cloudflared is missing and brew is not installed"
        say "installing cloudflared..."
        brew install cloudflared >/dev/null || die "could not install cloudflared"
    fi
}

# ---------------------------------------------------------------------- up

ensure_tunnel() {
    # A named tunnel that does not exist yet is a one-off setup step, so do it
    # rather than printing instructions for it.
    [ -n "$TUNNEL_HOSTNAME" ] || return 0
    if [ ! -f "$HOME/.cloudflared/cert.pem" ]; then
        die "cloudflared is not logged in yet — run once, it opens a browser:
    cloudflared tunnel login"
    fi
    if cloudflared tunnel list 2>/dev/null | awk '{print $2}' | grep -qx "$TUNNEL_NAME"; then
        return 0
    fi
    say "creating the tunnel $TUNNEL_NAME..."
    cloudflared tunnel create "$TUNNEL_NAME" >/dev/null \
        || die "could not create the tunnel"
    cloudflared tunnel route dns "$TUNNEL_NAME" "$TUNNEL_HOSTNAME" >/dev/null \
        || die "could not point $TUNNEL_HOSTNAME at the tunnel"
    say "created, and $TUNNEL_HOSTNAME now routes to it"
}

cmd_up() {
    ensure_deps
    ensure_tunnel
    mkdir -p "$LOG_DIR"

    if alive server && alive tunnel; then
        say "already running"
        cmd_url
        return 0
    fi
    # A half-dead pair is worse than a stopped one.
    if alive server || alive tunnel; then cmd_down >/dev/null 2>&1 || true; fi

    cd "$REPO_DIR"
    nohup python3 -m evotrader.cli serve-http --server "$SERVER" --port "$PORT" \
        >"$LOG_DIR/server.log" 2>&1 &
    echo $! > "$LOG_DIR/server.pid"

    local ready=""
    for _ in $(seq 1 40); do
        if curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then ready=1; break; fi
        sleep 0.25
    done
    [ -n "$ready" ] || { warn "the server did not start:"; tail -5 "$LOG_DIR/server.log" >&2; exit 1; }
    say "server up on :$PORT"

    if [ -n "$TUNNEL_HOSTNAME" ]; then
        nohup cloudflared tunnel --url "http://localhost:$PORT" run "$TUNNEL_NAME" \
            >"$LOG_DIR/tunnel.log" 2>&1 &
    else
        nohup cloudflared tunnel --url "http://localhost:$PORT" \
            >"$LOG_DIR/tunnel.log" 2>&1 &
    fi
    echo $! > "$LOG_DIR/tunnel.pid"

    local url=""
    for _ in $(seq 1 60); do
        url=$(public_url)
        [ -n "$url" ] && break
        sleep 1
    done
    [ -n "$url" ] || { warn "the tunnel did not come up:"; tail -5 "$LOG_DIR/tunnel.log" >&2; exit 1; }

    # Check the whole path, not just the parts: a 502 here means the tunnel is
    # live and the server is not, which is the one failure that looks like a
    # tunnel problem and is not.
    local code=""
    for _ in $(seq 1 10); do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 "${url%$ENDPOINT}/health" || true)
        [ "$code" = "200" ] && break
        sleep 1
    done
    say ""
    if [ "$code" = "200" ]; then
        say "  MCP server URL:  $url"
    else
        say "  MCP server URL:  $url"
        warn "  (the public address answered $code, not 200 — give it a few"
        warn "   seconds and run \`tunnel status\`)"
    fi
    say ""
    say "running in the background; \`tunnel stop\` when you are done"
}

cmd_down() {
    local stopped=0
    for name in server tunnel; do
        if alive "$name"; then kill "$(cat "$LOG_DIR/$name.pid")" 2>/dev/null && stopped=1; fi
        rm -f "$LOG_DIR/$name.pid"
    done
    if [ "$stopped" = 1 ]; then say "stopped"; else say "nothing was running"; fi
}

cmd_status() {
    if alive server; then say "server   running"; else say "server   stopped"; fi
    if alive tunnel; then say "tunnel   running"; else say "tunnel   stopped"; fi
    local url; url=$(public_url)
    if [ -n "$url" ]; then
        local code
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 10 "${url%$ENDPOINT}/health" 2>/dev/null || true)
        [ -z "$code" ] || [ "$code" = "000" ] && code="unreachable"
        say "public   $code  $url"
        if [ "$code" = "502" ]; then
            say "         (502 = the tunnel is up but the server is not)"
        fi
    fi
}

cmd_url() {
    local url; url=$(public_url)
    if [ -n "$url" ]; then say "$url"; else say "no URL yet — run \`tunnel\`"; fi
}

cmd_install() {
    local marker="# >>> mcp tunnel >>>"
    local rc="$HOME/.zshrc"
    [ -n "${BASH_VERSION:-}" ] && [ ! -f "$rc" ] && rc="$HOME/.bashrc"
    if grep -q "$marker" "$rc" 2>/dev/null; then
        say "already installed in $rc"
    else
        {
            printf '\n%s\n' "$marker"
            printf 'tunnel() { "%s/scripts/tunnel" "$@"; }\n' "$REPO_DIR"
            printf '%s\n' "# <<< mcp tunnel <<<"
        } >> "$rc"
        say "added \`tunnel\` to $rc"
    fi
    say "open a new terminal, or run:  source $rc"
}

load_config
case "${1:-up}" in
    ""|up|start) cmd_up ;;
    stop|down)   cmd_down ;;
    restart)     cmd_down; cmd_up ;;
    status)      cmd_status ;;
    url)         cmd_url ;;
    setup)       cmd_setup ;;
    install)     cmd_install ;;
    logs)        tail -n "${2:-20}" "$LOG_DIR/server.log" ;;
    *)           die "unknown command: $1 (try: up, stop, status, url, setup, install, logs)" ;;
esac
